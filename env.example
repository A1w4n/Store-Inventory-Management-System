# .env.example — Copy this to .env and fill in your values.
# Never commit .env to git.

# ── Desktop app (local) ────────────────────────────────────────────────────

# Your Render web service URL (no trailing slash).
# The desktop SyncEngine sends pushes and pulls here.
CLOUD_URL=https://your-app-name.onrender.com

# DATABASE_URL is only needed on Render, NOT on the desktop.
# Leave this blank or remove it from your local .env entirely.
# DATABASE_URL=


# ── Render web service (set these in Render → Environment) ────────────────

# Neon connection string — copy from:
#   Neon dashboard → your project → Connection Details → .env tab
# It already includes ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
